<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    离线预览器 / 离线闸门：不启动游戏也能验的那部分。
    移植 Spectre 的 replay + video render 之后，可链接的纯逻辑真源码是
    Features\Replay 下的编解码/数据类（不碰引擎 / 只依赖 System）：
      ReplayEncoder / ReplayDecoder / ReplayBinaryIO / ReplayCrypto /
      ReplayKeys / ReplayConstants / ReplayDataModels / Replay.cs
      以及 Features\VideoRender\VideoEncoder.cs（ffmpeg 参数拼装，纯 .NET）。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>UiPreview</AssemblyName>
    <RootNamespace>UiPreview</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <UseWindowsForms>false</UseWindowsForms>
    <NoWarn>$(NoWarn);CS0067;CS0414;CS0649</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- 文案表（Loc）链接真实源码 -->
    <Compile Include="..\..\SpectreReplay\Ui\Loc.cs" Link="Real\Loc.cs" />
    <!-- 回放文件格式编解码：纯 System，可直接跑往返测试 -->
    <Compile Include="..\..\SpectreReplay\Features\Replay\Replay.cs" Link="Real\Replay.cs" />
    <Compile Include="..\..\SpectreReplay\Features\Replay\ReplayKeys.cs" Link="Real\ReplayKeys.cs" />
    <Compile Include="..\..\SpectreReplay\Features\Replay\ReplayConstants.cs" Link="Real\ReplayConstants.cs" />
    <Compile Include="..\..\SpectreReplay\Features\Replay\ReplayDataModels.cs" Link="Real\ReplayDataModels.cs" />
    <Compile Include="..\..\SpectreReplay\Features\Replay\keyEvent.cs" Link="Real\keyEvent.cs" />
    <Compile Include="..\..\SpectreReplay\Features\Replay\HitContext.cs" Link="Real\HitContext.cs" />
    <Compile Include="..\..\SpectreReplay\Features\Replay\ReplayEncoder.cs" Link="Real\ReplayEncoder.cs" />
    <Compile Include="..\..\SpectreReplay\Features\Replay\ReplayDecoder.cs" Link="Real\ReplayDecoder.cs" />
    <Compile Include="..\..\SpectreReplay\Features\Replay\ReplayBinaryIO.cs" Link="Real\ReplayBinaryIO.cs" />
    <Compile Include="..\..\SpectreReplay\Features\Replay\ReplayCrypto.cs" Link="Real\ReplayCrypto.cs" />
    <Compile Include="..\..\SpectreReplay\Features\Replay\LegacyReplayData.cs" Link="Real\LegacyReplayData.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
